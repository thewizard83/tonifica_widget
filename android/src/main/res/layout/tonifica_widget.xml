<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tonifica_sfondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/t_settimana"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Settimana 1/12"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/t_passi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/t_blocco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Blocco 1 · Impara"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/t_barra"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="5"
        android:progressDrawable="@drawable/tonifica_progresso" />

    <TextView
        android:id="@+id/t_statistiche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="✓ 0 fatte · ✕ 0 saltate"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/tonifica_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/t_lettera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tonifica_lettera_a"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/t_etichetta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="PROSSIMA · PALESTRA"
                android:textColor="#6B5BE6"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/t_titolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Apri l'app per caricare il programma"
                android:textColor="#18221F"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/t_quando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:textColor="#5B6964"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/t_nota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/tonifica_chip"
                android:maxLines="2"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text=""
                android:textColor="#9A2D65"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
